# Copy to .env and fill in. Never commit real secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
# Behind a TLS-terminating load balancer keep this true; set false for plain-http local runs.
SECURE_SSL_REDIRECT=true
MFA_ENFORCED=true

# --- Database: connect as the NON-superuser app role (RLS does not apply to superusers) ---
DATABASE_URL=postgres://kitchenly:CHANGE_ME@db:5432/kitchenly
# Optional read replica for heavy reports
REPLICA_DATABASE_URL=
APP_DB_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://redis:6379

# --- Encryption of POS credentials/secrets (Fernet). Comma separated; first key encrypts, all decrypt.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- Object storage for CSV imports (leave empty to use local disk at MEDIA_ROOT) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Email (invitations, password reset) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Kitchenly <no-reply@example.com>
FRONTEND_URL=https://app.example.com

# --- Tuning ---
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=4
WEBHOOK_RATE_LIMIT=120/min
SYNC_EVENT_MAX_ATTEMPTS=6
SENTRY_DSN=
